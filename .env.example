# Copy to .env to run the live-provider tests (they skip when a key is absent).
TYPESAFE_API_KEY=your-typesafe-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenJEV - a free community gateway to the same Jev model (openjev.sh).
# Set JEV_PROVIDER=openjev to use it as the default instead of TypeSafe.
# OPENJEV_API_KEY=your-openjev-api-key
# JEV_PROVIDER=

# Set DECISION_ENGINE_LIVE=1 to opt in to tests that hit real provider APIs.
DECISION_ENGINE_LIVE=
